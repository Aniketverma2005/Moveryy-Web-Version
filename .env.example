# Moveryy Environment Configuration
# Copy this file to .env and update the values for your environment

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=ws://localhost:3001

# Authentication
REACT_APP_JWT_SECRET=your-jwt-secret-key
REACT_APP_REFRESH_TOKEN_EXPIRY=7d

# Push Notifications
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google Maps API (for location services)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Gateway
REACT_APP_RAZORPAY_KEY_ID=your-razorpay-key-id
REACT_APP_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# File Upload
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_UPLOAD_URL=http://localhost:3001/api/upload

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=your-ga-tracking-id
REACT_APP_MIXPANEL_TOKEN=your-mixpanel-token

# Error Reporting
REACT_APP_SENTRY_DSN=your-sentry-dsn

# Feature Flags
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true
REACT_APP_ENABLE_LOCATION_TRACKING=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_ANALYTICS=true

# Development
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info

# Social Login
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id
REACT_APP_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# SMS/Email Services
REACT_APP_TWILIO_ACCOUNT_SID=your-twilio-account-sid
REACT_APP_SENDGRID_API_KEY=your-sendgrid-api-key

# Database (for reference - backend only)
DATABASE_URL=postgresql://username:password@localhost:5432/moveryy
REDIS_URL=redis://localhost:6379

# Server Configuration (for reference - backend only)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000